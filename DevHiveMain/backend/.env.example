DEVHIVE_SECRET=replace-with-a-long-random-secret-at-least-32-characters
DEVHIVE_DATABASE_URL=sqlite:///./devhive.db
DEVHIVE_RAG_BACKEND=turbovec
DEVHIVE_SITE_URL=http://127.0.0.1:3000
# Automatic refresh runs every Sunday at 02:00 India time while FastAPI is running.
DEVHIVE_WEEKLY_SYNC_ENABLED=true
DEVHIVE_WEEKLY_SYNC_HOUR=2
# Workspace-wide Groq key: every signed-in user gets AI explanations without their own key.
# A personal key saved in Settings still takes priority. Keep this value out of source control.
DEVHIVE_GROQ_API_KEY=
DEVHIVE_GROQ_MODEL=openai/gpt-oss-120b
# Tokens per minute the shared key may use (free tier: 8000 per minute; raise on a paid plan).
DEVHIVE_GROQ_TPM=7000
# Load the embedding model at startup so the first question is fast.
DEVHIVE_WARM_MODEL=true
# Optional read-only GitHub token (fine-grained, no scopes) used for public repositories.
# Raises GitHub's limit from 60 to 5000 requests per hour. Never used for writes.
DEVHIVE_GITHUB_TOKEN=
# Files indexed per branch sync (30 when no GitHub token is available).
DEVHIVE_MAX_INDEX_FILES=400
# Optional Supabase Auth. Use your project URL, publishable key, and server-only secret key.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
# For Supabase, set DEVHIVE_DATABASE_URL=postgresql+psycopg://... and run migrations/001_vectors.sql.
# DEVHIVE_RAG_BACKEND=supabase
# Install requirements-semantic.txt, then set this to enable semantic retrieval.
# The first use downloads the 384-dimensional model. Sync each branch again after enabling it.
# DEVHIVE_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
# HF_HOME=./.cache/huggingface
# After the model is cached, set these to avoid online checks on each start.
# HF_HUB_OFFLINE=1
# TRANSFORMERS_OFFLINE=1
