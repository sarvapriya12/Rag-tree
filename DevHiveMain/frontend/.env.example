BACKEND_URL=http://127.0.0.1:8000
DATABASE_URL=file:./ui.db
NEXT_SESSION_SECRET=replace-with-a-different-long-random-secret-at-least-32-characters
# Optional Supabase Auth. Publishable values only; never put a secret key here.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# GitHub OAuth App. Set the callback URL to this exact address in GitHub.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_OAUTH_REDIRECT_URL=http://127.0.0.1:3000/api/github/callback
